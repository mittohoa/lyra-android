<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Nhin thay duoc cac app NHAC, chi de doc TEN cua chung.

      Dai ngu canh ghi bai nay den tu dau. Voi nhac AURA tu phat thi biet san,
      con nhac phat o app khac thi chi cam duoc ten goi - ma tu Android 11, hoi
      ten hien thi cua mot goi khac se nem loi neu khong khai bao gi o day.

      Khai theo INTENT chu khong dung `QUERY_ALL_PACKAGES`: cai kia mo ca may va
      Play soi rat ky, con cai nay chi mo dung nhung app co dich vu duyet nhac -
      tuc dung tap app ma AURA co the dang doc bai dang phat. Hep hon, va noi
      thang duoc ly do.

      App nao khong co dich vu do thi khong doc duoc ten, va luc do dai ngu canh
      bo hang nguon di chu khong bay ra ten goi.
    -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <!--
      Ve de len app khac. Nguoi dung phai tu bat trong Cai dat Android; khai o
      day chi de he thong cho phep mo dung trang cai dat do.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Phat nhac khi man hinh tat. `mediaPlayback` la kieu bat buoc khai bao tu
      Android 14 - thieu no thi he thong nem SecurityException ngay khi service
      chuyen sang chay nen.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Thong bao dieu khien nhac. Tu Android 13 nguoi dung phai dong y - khong
      dong y thi nhac van phat, chi la khong co the dieu khien.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Doc nhac co san trong may. Tu Android 13 tach rieng theo loai: xin dung
      quyen NHAC chu khong phai quyen doc ca bo nho - AURA khong co viec gi voi
      anh, video hay tai lieu cua nguoi dung.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Goi LRCLIB / Zing / NCT de tra loi bai hat -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AURA">

        <!--
          `singleTop` la vi LOI TAT.

          Khong co no thi bam loi tat "Tim bai" trong luc app dang mo se DUNG
          THEM mot ban MainActivity nua chong len ban cu: bam Back mot cai ra
          mot cai y het, va toan bo trang thai man hinh cu (o tim dang go do,
          trang dang xem) van nam do khong ai thay. `singleTop` dua Intent do
          vao `onNewIntent` cua ban dang co - mot man hinh, mot trang thai.

          HINH TRONG HINH cho video (`supportsPictureInPicture`).

          Truoc day dat "false" - khong kem ly do nao, tuc la no tat theo mac
          dinh chu khong phai co ai can nhac roi quyet. Ma AURA quet ca thu muc
          phim va phat video that, nen roi app la mat hinh: dung thu co ban
          nhat ma mot trinh xem video phai co.

          `configChanges` da co `screenSize` va `screenLayout`, nen vao ra cua
          so nho khong dung lai Activity - khong co chung thi moi lan thu nho
          la mot lan dung lai bo phat va hinh nhay den mot nhip.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Bat/tat khung loi noi tu loi tat, KHONG mo app.

          `Theme.NoDisplay` + `noHistory` + `excludeFromRecents`: khong ve gi,
          khong de lai gi trong danh sach ung dung gan day. Nguoi dung bam loi
          tat va thay khung loi hien len ngay tren app nhac ho dang mo - khong
          co mot khung AURA nao nhap nhay o giua.

          Bang loi tat cua trinh khoi chay KHONG tu dong sau khi bam. Da thu
          `Theme.Translucent.NoTitleBar` va da thu doi `finish()` xuong
          `onResume`; ca hai deu khong doi duoc gi. Xem `LoiNoiActivity`.
        -->
        <activity
            android:name=".ui.LoiNoiActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/tile_label" />

        <!--
          Neo cua ca app. Ta khong doc thong bao - chi can lop nay ton tai thi
          he thong moi cho goi getActiveSessions. Doi lai duoc mot cho tru chay
          nen ma khong phai hien thong bao thuong truc.
        -->
        <service
            android:name=".service.LyraNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Bo may phat cua chinh AURA.

          `exported=true` la BAT BUOC voi MediaSessionService: he thong, Android
          Auto va cac o dieu khien ngoai deu noi vao tu tien trinh khac. Doi lai
          phai loc quyen o phia trong session neu ve sau co lenh nhay cam.
        -->
        <service
            android:name=".player.LyraPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Widget khung loi tren man hinh chinh.

          `exported=true` la bat buoc voi moi AppWidgetProvider: bo dung man
          hinh chinh la mot app khac, va no phai goi duoc vao day.

          Chi khai APPWIDGET_UPDATE. Ta KHONG dang ky nhan cac broadcast khac
          (doi bai, doi trang thai phat) - widget duoc AURA tu day len tu tien
          trinh cua chinh no, xem `Lyra.pushLineToWidget`. Mot broadcast cho
          moi cau lo la nhieu lan danh thuc he thong hon can.
        -->
        <receiver
            android:name=".widget.KhungLoiWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/khung_loi_widget" />
        </receiver>

        <!--
          O Quick Settings. Nguoi dung phai tu keo no vao bang o - Android
          khong cho app tu them, va dung ra la vay.
        -->
        <service
            android:name=".service.LyraTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Duong gui mot tam the loi ra app khac.

            `authorities` gan vao `applicationId` chu khong viet cung: ban tai
            thang va ban debug cai canh nhau duoc, ma hai app khai trung mot
            authority thi cai sau KHONG CAI DUOC - he thong tu choi, khong bao
            ly do gi ro rang.

            `exported="false"` va `grantUriPermissions="true"`: khong app nao
            doc bua duoc, chi app nao duoc `ACTION_SEND` trao quyen tam thoi.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.chiase"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/duong_chia_se" />
        </provider>

    </application>
</manifest>
